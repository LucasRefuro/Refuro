{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:pad*",
      "has": [{ "type": "host", "value": "login.storvo.app" }],
      "destination": "https://storvo.app/app/",
      "permanent": false
    },
    {
      "source": "/:pad*",
      "has": [{ "type": "host", "value": "inloggen.storvo.app" }],
      "destination": "https://storvo.app/app/",
      "permanent": false
    },
    {
      "source": "/:pad*",
      "has": [{ "type": "host", "value": "admin.storvo.app" }],
      "destination": "https://storvo.app/admin/",
      "permanent": false
    }
  ]
}
